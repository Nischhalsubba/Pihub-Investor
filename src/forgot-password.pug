//- Header file
<!DOCTYPE html>
html(lang="en")
    head
        include templates/head.pug
        title Email Confirm
    body
        img(src="./assets/img/logo.png", alt="company logo",class="company-logo company-logo-email")
        .container-full-height.text-centerd.d-flex
            .content.m-auto 

                .email-content
                    .w-75.m-auto.text-center    
                        img(src="./assets/img/icons/activated.png", alt="Mail icon") 

                        h3 Forgot Password?
                        P Enter an email associated with your account. We will send you recovery email.
                    .w-75.m-auto    
                        form.form-signin(action="")
                            .form-group.text-left.w-75
                                label(for="email-address") Email Address
                                input(type="email", name="email-address" class="form-control") 
                            button.btn.btn-primary.btn-form(type="submit") 
                                a.text-white(href="all-products.html" class="btn-primary") Send	       


