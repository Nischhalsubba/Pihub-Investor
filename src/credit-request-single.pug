                                        a(href="") 08/08/1921
                                    td.text-right-piehub-table.font-weight-bold $946652
                                    td.text-right-piehub-table
                                        a(href="", class="mr-1")
                                            img(src="assets/img/icons/bx-check-circle.svg", alt="accepted")
                                        a(href="") 
                                            img(src="assets/img/icons/bx-x-circle.svg", alt="rejected")  
                                tr
                                    td 
                                        a(href="") Tempor Barber
                                    td
                                        a(href="") 26/08/1949
                                    td.text-right-piehub-table.font-weight-bold $462551
                                    td.text-right-piehub-table
                                        a(href="", class="mr-1")
                                            img(src="assets/img/icons/bx-check-circle.svg", alt="accepted")
                                        a(href="") 
