                                    td.text-right-piehub-table
                                        a(href="", class="mr-1")
                                            img(src="assets/img/icons/bx-check-circle.svg", alt="accepted")
                                        a(href="") 
                                            img(src="assets/img/icons/bx-x-circle.svg", alt="rejected")  
