//- Header file
<!DOCTYPE html>
html(lang="en")
    head
        include templates/head.pug
        title Credit Request on IT investment
    body
        .container-full-height.ct-container
            .sidebar
                include components/nav-sidebar
            .main-content.main-content--padded
                include templates/site-header
                .content-head
                    .content-head-left
                        h1.content-head__title Credit Request on IT investment

                .content-body.credit-request
                    .d-flex
                        .col-lg-12.col-xl-8
                            .row.justify-content-between.w-100
                                .col-3.p-0
                                    h6 States
                                    a(href="#") Berlin
                                .col-3.p-0
                                    h6 Credit Type
                                    a(href="#") Resolving credit  
                                .col-3.p-0
                                    h6 County
                                    a(href="#") Germany
                                .col-3.p-0
                                    h6 Industries
                                    .d-flex.flex-wrap.justify-content-between.flex-column
                                        a.mb-1(href="#") Service Industry
                                        a.mb-1(href="#") Administration and office work
                                        a.mb-1(href="#") Banking and financial services 
                                        a.mb-1(href="#") Marketing, advertising and PR
                                        a.mb-1(href="#") Healthcare
                                        a.mb-1(href="#") Tourism, hotel and gastronomy
                            .row.justify-content-between.w-100.mt-3
                                .col-3.p-0
                                    h6 Creditrre form
                                    span AAA
                                .col-3.p-0
                                    h6 Standard & Poors
                                    span A+
                                .col-3.p-0  
                                    h6 Bank/Andere
                                    span AAA+
                                .col-3.p-0
                                    h6 Bank/Andere
                                    span AAA+
                        .col-lg-12.col-xl-4.rightbar
                            .amount
                                h6 Requested amount of
                                h2 $400,000
                            .investor.clearfix.mt-5
                                h6 Requested By
                                .investor-profile.d-flex.align-items-center
                                    img(src="assets/img/investor-profile.jpg", alt="Investor profile picture")
                                    a(href="#",class="ml-2") John Doe
                            .date.mt-5
                                h6 Request on
                                a(href="#") Jan 23, 2019                  
                    .attachments
                        h4 Attachments
                        .file.mb-2
                            span.file-name tax payer investment.docx
                            span.ml-4.file-size 400.5kb
                        .file
                            span.file-name investment agreement.pdf
                            span.ml-4.file-size 322.2kb

                    .requests.mt-5
                        h4 Credit Requests
                        hr
                        table.table.tablesaw-stack(data-tablesaw-mode="stack" data-tablesaw-minimap)
                            thead
                                tr 
                                    th(data-tablesaw-sortable-col) Requested By
                                    th(data-tablesaw-sortable-col data-tablesaw-priority="persist" scope="col") Requested On
                                    th.text-right-piehub-table(data-tablesaw-sortable-col scope="col") Requested Amount
                                    th.text-right-piehub-table(data-tablesaw-sortable-col scope="col") Accept/Decline
                            tbody
                                tr
                                    td 
                                        a(href="") Reprehenderit Marshall
                                    td
                                        a(href="") 07/04/1927
                                    td.text-right-piehub-table.font-weight-bold $238638
                                    td.text-right-piehub-table
                                        a(href="", class="mr-1")
                                            img(src="assets/img/icons/bx-check-circle.svg", alt="accepted")
                                        a(href="") 
                                            img(src="assets/img/icons/bx-x-circle.svg", alt="rejected")     
                                tr
                                    td 
