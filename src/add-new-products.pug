//- Header file
<!DOCTYPE html>
html(lang="en")
	head
		include templates/head.pug
		title Add New Product
	body
		.container-full-height.ct-container
			.sidebar
				include components/nav-sidebar
			.main-content.main-content--padded
				include templates/site-header
				.content-head
					.content-head-left
						h1.content-head__title All Products

				.content-body
					form.form-signup(action="add-new-products-sucess.html")
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="product-title") Product Title
									input(type="text", name="product-title" class="form-control")
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="state") States
									select.form-control.states
										option(value="Baden-Württemberg") Baden-Württemberg
										option(value="Bavaria") Bavaria
										option(value="Berlin") Berlin
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="credit-type") Credit Type
									select.form-control
										option(value="revolving-credit") Revolving Credit
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="country") Country
									select.form-control
										option(value="argentina") Argentina
										option(value="germany") Germany
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="Industry") Industry
									select.form-control
										option(value="service-industry") Service Industry
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for='time-duration' class="d-block") Time Duraction (Months)
									.row.align-items-end
										.col.col-2
											input(type='text' class="form-control" id="time-duration-min" value="1")
										.col.col-8
											input#time-duration.w-100(type="range")
										.col.col-2
											input(type='text' class="form-control" id="time-duration-max" value="12")

						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
										.row.align-items-end
											.col.col-10
												label(for='mincredit-amount' class="d-block mincredit-amount mb-5") Minimum Credit Amount 
												input#mincredit-amount.w-100(type='range')
											.col.col-2
												input(type='text' class="form-control" id="mincredit-amount-value" data-prefix="$")
							.col-12.col-sm-12.col-md-6
								.form-group
										.row.align-items-end
											.col.col-10
												label(for='mincredit-amount' class="d-block mincredit-amount mb-5") Maximum Credit Amount
												input#maxcredit-amount(type='range' class="w-100")
											.col.col-2
												input(type="text" class="form-control" id="maxcredit-amount-value" data-prefix="$")
						.row.mt-4
							.col
								.form-group
									label.d-block Rating for Credit
									.form-check.form-check-inline
										input.form-check-input(type="radio" name="rating-for-credit" id="rating-credit-yes" value="yes" checked)
										label.form-check-label(for="rating-credit-yes") Yes
									.form-check.form-check-inline
										input.form-check-input(type="radio" name="rating-for-credit" id="rating-credit-no" value="no")
										label.form-check-label(for="rating-credit-no") No
								
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.row
									.col-12.col-sm-12.col-md-6
										.form-group
											.row.align-items-center
												.col
													.form-check
														input.form-check-input(type="checkbox" name="rating-for-credit" id="rating-credit-yes" checked)
														label.form-check-label(for="rating-credit-yes") Creditform
												.col
													input.form-control(type="text", name="creditform" value="A-")
									.col-12.col-sm-12.col-md-6
										.form-group
											.row.align-items-center
												.col
													.form-check
														input.form-check-input(type="checkbox" name="rating-for-credit" id="euler-hermes")
														label.form-check-label(for="euler-hermes") Euler Hermes
												.col
													input.form-control(type="text", name="euler-hermes" value="")
						
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.row
									.col-12.col-sm-12.col-md-6
										.form-group
											.row.align-items-center
												.col
													.form-check
														input.form-check-input(type="checkbox" name="rating-for-credit" id="fitch" checked)
														label.form-check-label(for="fitch") Fitch
												.col
													input.form-control(type="text", name="fitch" value="")
									.col-12.col-sm-12.col-md-6
										.form-group
											.row.align-items-center
												.col
													.form-check
														input.form-check-input(type="checkbox" name="rating-for-credit" id="standar-poors")
														label.form-check-label(for="standar-poors") Standard & Poors
												.col
													input.form-control(type="text", name="standerd-poors" value="A-")

						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.row
									.col-12.col-sm-12.col-md-6
										.form-group
											.row.align-items-center
												.col
													.form-check
														input.form-check-input(type="checkbox" name="rating-for-credit" id="moodys")
														label.form-check-label(for="moodys") Moody's
												.col
													input.form-control(type="text", name="moodys" value="")
									.col-12.col-sm-12.col-md-6
										.form-group
											.row.align-items-center
												.col
													.form-check
														input.form-check-input(type="checkbox" name="rating-for-credit" id="bank-andere")
														label.form-check-label(for="bank-andere") Bank/Andere
												.col
													input.form-control(type="text", name="bank-andere" value="A-")

						.row.mt-4
							.col
								.form-group
									label(for="" class="d-block") File Upload

									#tpl.d-none
										.dz-preview.dz-file-preview
											.dz-progress
												span.dz-upload(data-dz-uploadprogress='')
											.dz-details
												.dz-filename
												span(data-dz-name='')
												.dz-size(data-dz-size='')
												img(src='removebutton.png' alt='X' data-dz-remove='')

									.file-upload-display

									//- .file-upload-display.mb-4 
										//- .progress.progress-striped.active(role='progressbar', aria-valuemin='0', aria-valuemax='100', aria-valuenow='0')
										//- .progress-bar.progress-bar-success(style='width:0%;', data-dz-uploadprogress='')
										
									.border-dotted
										#file_dropzone.position-relative
											.dz-message.needsclick.w-25.position-absolute
												img(src="./assets/img/icons/bx-cloud-upload.png", alt="" class="d-block m-auto")
												.text-center.mt-3
													a(href="" class="font-weight-bold") Add file 
													span
														| or drop files here
														input(type="file", name="" class="d-none")

											.fallback
												input(name='file', type='file', multiple='')

						.row.mt-4
							.col
								button.btn.btn-primary.btn-form(type="submit") Submit
