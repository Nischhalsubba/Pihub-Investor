//- Header file
<!DOCTYPE html>
html(lang="en")
	head
		include templates/head.pug
		title Add New Product
	body
		.container-full-height.ct-container
			.sidebar
				include components/nav-sidebar
			.main-content.main-content--padded
				include templates/site-header
				.content-head
					.content-head-left
						h1.content-head__title Add New Product

				.content-body
					form.form-signup(action="add-new-products-sucess.html")
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label Product Title
									input(type="text", name="product-title" class="form-control")
							.col-12.col-sm-12.col-md-6
								.form-group
									label States
									select.form-control.states
										option(value=" ") Select States
										option(value="Advertisement/Online Marketing") Berlin
										option(value="Advertisement/Marketing") Baden-Württemberg
										option(value="Advertisement/Offine Marketing") Brandenburg

						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label Credit type
									select.form-control.states
										option(value=" ") Select Credit type
										option(value="Advertisement/Online Marketing") Revolving credit
							.col-12.col-sm-12.col-md-6
								.form-group
									label County
									select.form-control.states
										option(value=" ") Select County
										option(value="Advertisement/Online Marketing") Camden
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="Industry") Industry
									input.form-control(type="text", name="Industry")
						
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="time") Time Duration (Months)
									.d-flex.align-items-center
										input.form-control.col-md-2.mr-2.text-center(type="text", name="",value="1")
										.demo.w-100
											input.position-relative.w-100(type="range", name="")
										input.form-control.col-md-2.ml-2.text-center(type="text", name="",value="36")
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="amount") Minimum credit Amount
									.form-group-ranger
										input.range-slider(type="range", name="")
										.input-group
											.input-group-prepend
												span.input-group-text €
											input.form-control(type="text", name="",value="£ 50.000")
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="amount") Maximum credit Amount
									.d-flex.align-items-center
										.demo.col-md-9.col-sm-8.col-8
											input.position-relative.w-100(type="range", name="")
										input.form-control.col-md-3.col-sm-4.col-4.ml-2.text-center(type="text", name="",value="£ 30.000.000")
						.row.mt-4
							.col-12.col-sm-12.col-md-6
								.form-group
									label(for="rating") Rating For Credit
									.option
										input(type="radio", name="rating",value="yes")/  Yes
										input.ml-4(type="radio", name="rating", value="no")/  No
										.rating.d-flex.justify-content-between.align-content-center.flex-wrap.mt-3
											.rating-item
												.col-9.p-0
													input.mr-2(type="checkbox",name="industry",value="")/ Creditreform
												input.col-3.form-control.text-center(type="text", name="")
											.rating-item
												.col-9
													input.mr-2(type="checkbox",name="industry",value="")/ Euler Hermes
												input.col-3.form-control.text-center(type="text", name="")
											.rating-item
												.col-9.p-0
													input.mr-2(type="checkbox",name="industry",value="")/ Fitch
												input.col-3.form-control.text-center(type="text", name="")
											.rating-item
												.col-9
													input.mr-2(type="checkbox",name="industry",value="")/ Standard & Poors
												input.col-3.form-control.text-center(type="text", name="")
											.rating-item
												.col-9.p-0
													input.mr-2(type="checkbox",name="industry",value="")/ Moody’s
												input.col-3.form-control.text-center(type="text", name="")
											.rating-item
												.col-9
													input.mr-2(type="checkbox",name="industry",value="")/ Bank/Andere
												input.col-3.form-control.text-center(type="text", name="")
						.row.mt-4
							.col
								.form-group
									label(for="" class="d-block") File Upload

									#tpl.d-none
										.dz-preview.dz-file-preview
											.dz-progress
												span.dz-upload(data-dz-uploadprogress='')
											.dz-details
												.dz-filename
												span(data-dz-name='')
												.dz-size(data-dz-size='')
												img(src='removebutton.png' alt='X' data-dz-remove='')

									.file-upload-display

									//- .file-upload-display.mb-4 
									//- .progress.progress-striped.active(role='progressbar', aria-valuemin='0', aria-valuemax='100', aria-valuenow='0')
									//- .progress-bar.progress-bar-success(style='width:0%;', data-dz-uploadprogress='')

									.border-dotted
										#file_dropzone.position-relative
											.dz-message.needsclick.w-25.position-absolute
												img(src="./assets/img/icons/bx-cloud-upload.png", alt="" class="d-block m-auto")
												.text-center.mt-3
													a(href="" class="font-weight-bold") Add file 
													span
														| or drop files here
														input(type="file", name="" class="d-none")

											.fallback
												input(name='file', type='file', multiple='')

						.row.mt-4
							.col
								button.btn.btn-primary.btn-form(type="submit") Submit
