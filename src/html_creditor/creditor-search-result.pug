                                                option(value="Advertisement/Marketing") Advertisement/Marketing
                                                option(value="Advertisement/Offine Marketing") Advertisement/Offine Marketing
                            .col-12.col-sm-12.col-md-6
                                .form-group
                                    .row.align-items-end
                                        .col.col-12
                                            label(for="first-name") Region
                                            input(type="text", name="product-title" class="form-control",placeholder="Deutshland")
                        .row.mt-4
                            .col-12.col-sm-12.col-md-6
                                .form-group 
                                    .row.align-items-end
                                        .col.col-12
                                            label(for='interest' class="d-block interest ") Posted From
                                            input#interest(type='date' class="w-100 form-control" placeholder="Choose a date")
                            .col-12.col-sm-12.col-md-6
                                .form-group
                                    label(for='interest' class="d-block interest ") To
                                    input#interest(type='date' class="w-100 form-control" placeholder="Choose a date")
                        .row.mt-4
                            .col
                                button.btn.btn-primary.btn-form(type="submit") Search
                hr.mt-5

