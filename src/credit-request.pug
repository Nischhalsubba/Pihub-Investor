                            +creditor-list('John doe', 'It Investment', 'Corporate Loan', '07/04/2019', '08-09/2020', '40000', 'badge-success', 'Success')
                            +creditor-list('John doe', 'It Investment', 'Corporate Loan', '07/04/2019', '08-09/2020', '40000', 'badge-success', 'Success')
                            +creditor-list('John doe', 'It Investment', 'Corporate Loan', '07/04/2019', '08-09/2020', '40000', 'badge-success', 'Success')
                            +creditor-list('John doe', 'It Investment', 'Corporate Loan', '07/04/2019', '08-09/2020', '40000', 'badge-success', 'Success')

                .content-footer
                    nav.nav-content
                        ul.pagination
                            li.page-item
                                a.page-link(href="")
                                    i.bx.bx-chevron-left
