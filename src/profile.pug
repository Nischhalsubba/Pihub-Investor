                                        img.mr-3(src="/assets/img/icons/facebook.png", alt="alt", width="25px", height="25px")
                                    a(href="#", target="_blank", rel="noopener noreferrer")
                                        img.mr-3(src="/assets/img/icons/twitter.png", alt="alt", width="25px", height="25px")
                                    a(href="#", target="_blank", rel="noopener noreferrer")
                                        img(src="/assets/img/icons/linkedin.png", alt="alt", width="25px", height="25px")

                    .content-head-right
                        a.btn.btn-primary(href="add-new-products.html") Edit Profile   
