html(lang="en")
	head
		include templates/head.pug
		title Change Password
	body
		.container-full-height.ct-container
			.sidebar
				include components/nav-sidebar
			.main-content.main-content--padded
				include templates/site-header
				.content-head
					.content-head-left
						h1.content-head__title Change Password
				.content-body
					form.form-chagne-password(action="change-password-success.html")
						.form-group
							label(for="old-password") Old Password
							input.form-control(type="password", name="old-password")
						.form-group
							label(for="new-password") New Password
							input.form-control(type="password", name="new-password")
						.form-group
							label(for="new-password-confirm") Confirm Password
							input.form-control(type="password", name="new-password-confirm")
						button.btn.btn-primary(type="submit") Change My Password