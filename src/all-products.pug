//- Header file
<!DOCTYPE html>
html(lang="en")
	head
		include templates/head.pug
		title This is right
	body
		.container-full-height.ct-container
			.sidebar
				include components/nav-sidebar
			.main-content.main-content--padded
				include templates/site-header
				.content-head
					.content-head-left
						h1.content-head__title All Products
				.content-head
					a.btn.btn-primary(href="add-new-products.html") Add New Product

					form.form-inline.my-2.my-lg-0
						input.form-control.mr-sm-2(type='search' placeholder='Search' aria-label='Search')
						a.btn.btn-primary(href="add-new-products.html") Search

				.content-body
