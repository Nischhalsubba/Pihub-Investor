//- Header file
<!DOCTYPE html>
html(lang="en")
    head
        include templates/head.pug
        title Credit Request on IT investment
    body
        .container-full-height.ct-container
            .sidebar
                include components/nav-sidebar
            .main-content.main-content--padded
                include templates/site-header
                .content-head.flex-column.align-items-start
                    .content-head-left.w-100
                        h1.content-head__title Credit Request on IT investment

                        .alert.alert-sucess
                            | You have accepted the investment

                .content-body.credit-request.mt-4
                    .row.justify-content-between.w-100
                        .col-lg-12.col-xl-8
                            .clearfix.mb-4
                                .sub-heading.clearfix.float-left
                                    p.font-weight-bold.mb-2  Requested for
                                    h4.float-left IT Investment
                                a.btn.btn-primary.float-right.mt-2(href="") Make an offer
                            //- content
                            .credit-information
                                .row.pt-4
                                    .col
                                        h6 Service/Industy Expertise
                                        span Customer Service
                                    .col.text-right
                                        h6 Financing Needs
                                        span $25000
                                    .col.text-right
                                        h6 Collateral
                                        span John Doe, $2522
                                .row.pt-5
                                    .col
                                        h6 Deadline
                                        span April 1, 2019
                                    .col.text-right
                                        h6 NDA Requirement
                                        span 
                                            a(href="http://", target="_blank", rel="noopener noreferrer")  NDA_piHub.pdf
                                    .col.text-right
                                        h6 Minimum Credit amount
                                        span $4500

                        .col-lg-12.col-xl-4.rightbar
                            .amount
                                h6 Requested amount of
                                h2 $400,000
                            .investor.clearfix.mt-5
                                h6 Requested By
                                .investor-profile.d-flex.align-items-center
                                    img(src="assets/img/investor-profile.jpg", alt="Investor profile picture")
                                    a(href="#",class="ml-2") John Doe
                            .date.mt-5
                                h6 Request on
                                a(href="#") Jan 23, 2019
                    .attachments.mt-5.mb-5
                        h4 Attachments
                        .file.mb-2
                            span.file-name tax payer investment.docx
                            span.ml-4.file-size 400.5kb
                        .file
                            span.file-name investment agreement.pdf
                            span.ml-4.file-size 322.2kb
                    span.mt-3
                        a(href="#", class="btn btn-option") Accepted