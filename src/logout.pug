//- Header file
<!DOCTYPE html>
html(lang="en")
    head
        include templates/head.pug
        title This is right
    body
        .container-fluid.container-full-height
            .row.container-full-height
                .signin-form-container.col-md-6
                    .singin-container
                        .alert.alert-sucess
                            | You have been successfully logged out
                        header.page-header
                            h1.page-title Log in

                        form.form-signin(action="")
                            .form-group
                                label(for="email-address") Email Address
                                input(type="email", name="email-address" class="form-control")
                            .form-group
                                label(for="password") Password
                                input(type="password", name="password" class="form-control")
                                a(href="") Don't remember your password?
                            button.btn.btn-primary.btn-form(type="submit") 
                                a(href="all-products.html" class="btn-primary") Login	
                .signin-banner-container.col-md-6
                    .signin-banner
                        header.signin-banner__header
                            h2.signin-banner__title Perfect Investment
                            p.signin-banner__desc Lorem ipsum dolor sit amet, consetetur sadipscing elitr, sed diam nonumy eirmod tempor invidunt ut labore et dolore magna.
                        img.signin-banner__thumb(src="assets/img/signin-image.png", alt="Perfect Investment Image")