{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "packages/ui/src/**",
    "packages/platform/src/**",
    "packages/domain/src/**"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test:unit": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
