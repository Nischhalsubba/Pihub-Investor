{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix app --legacy-peer-deps",
  "buildCommand": "CI=false NODE_OPTIONS=--openssl-legacy-provider npm --prefix app run build",
  "outputDirectory": "app/build",
  "rewrites": [
    {
      "source": "/credittech-api/:path*",
      "destination": "http://api.credittech.diagonal.solutions/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/credittech-api/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ]
}
