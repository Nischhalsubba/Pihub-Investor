# PiHub Investor local environment example.
# Copy to .env.local for development. Never commit real credentials or secrets.

REACT_APP_DEMO=true
REACT_APP_PIHUB_MODULE_ID=investor

# Local development may use an HTTP localhost endpoint when needed.
# Production builds reject any non-HTTPS value.
REACT_APP_API_URL=
REACT_APP_API_HEADER_FROM=investor

# Cross-application destinations. Production builds require HTTPS when set.
REACT_APP_INVESTOR_APP_URL=
REACT_APP_BORROWER_APP_URL=https://pihub-borrower-nischhalsubbas-projects.vercel.app
REACT_APP_ADVISORY_APP_URL=https://pihub-advisory-nischhalsubbas-projects.vercel.app
REACT_APP_ADMIN_APP_URL=https://pihub-admin-nischhalsubbas-projects.vercel.app
REACT_APP_ACCESS_APP_URL=
