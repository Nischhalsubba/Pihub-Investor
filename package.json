{
  "name": "pihub-platform",
  "version": "1.0.0",
  "private": true,
  "description": "PiHub multi-application platform workspace.",
  "license": "UNLICENSED",
  "packageManager": "npm@10.9.2",
  "engines": { "node": ">=24" },
  "workspaces": [
    "apps/borrower",
    "apps/advisory",
    "apps/admin",
    "apps/access"
  ],
  "scripts": {
    "check:platform-suite": "node tooling/check-platform-suite.mjs",
    "build:platform": "npx --yes turbo@2.8.0 run build",
    "test:platform": "npx --yes turbo@2.8.0 run test:unit",
    "quality:platform": "node tooling/check-platform-suite.mjs && npx --yes turbo@2.8.0 run test:unit build"
  }
}
